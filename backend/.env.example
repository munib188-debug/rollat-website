MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=rollat_database
CORS_ORIGINS=https://rollat.vercel.app,http://localhost:3000

# Sign-in-with-Solana (Phase B). Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 chars. NEVER commit the real value.
JWT_SECRET=replace-me-with-64-random-chars-from-the-command-above
APP_DOMAIN=rollat.vercel.app
APP_URI=https://rollat.vercel.app
